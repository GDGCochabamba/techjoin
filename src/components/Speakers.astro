---
import type { PopulatedParticipant } from "../lib/event";

interface Props {
  speakers: PopulatedParticipant[];
}
const { speakers } = Astro.props;
---

{speakers.length > 0 && (
  <section id="speakers" class="bg-slate-50 py-16">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="mb-10 text-center text-3xl font-bold sm:text-4xl">Speakers</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {speakers.map(({ participant, person }) => (
          <article class="overflow-hidden rounded-2xl bg-white shadow-md transition hover:shadow-lg">
            <div class="aspect-[4/3] w-full bg-slate-200">
              {person.photoUrl ? (
                <img
                  src={person.photoUrl}
                  alt={person.name}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center text-5xl font-bold text-slate-400">
                  {person.name.charAt(0)}
                </div>
              )}
            </div>
            <div class="p-5">
              <h3 class="text-lg font-semibold">{person.name}</h3>
              {participant.talkTitle && (
                <p class="mt-1 text-sm font-medium text-blue-600">{participant.talkTitle}</p>
              )}
              {(participant.bioOverride ?? person.bio) && (
                <p class="mt-3 line-clamp-4 text-sm leading-relaxed text-slate-600">
                  {participant.bioOverride ?? person.bio}
                </p>
              )}
              <div class="mt-4 flex flex-wrap gap-2 text-xs">
                {Object.entries(person.socials).map(([type, url]) =>
                  url ? (
                    <a
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded-full bg-slate-100 px-3 py-1 text-slate-700 transition hover:bg-slate-200"
                    >
                      {type}
                    </a>
                  ) : null,
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
