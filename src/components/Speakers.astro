---
import { Image } from "astro:assets";
import type { PopulatedParticipant } from "../lib/event";

interface Props {
  speakers: PopulatedParticipant[];
}
const { speakers } = Astro.props;

const SOCIAL_LABELS: Record<string, string> = {
  linkedin: "LinkedIn",
  twitter: "X",
  github: "GitHub",
  instagram: "Instagram",
  youtube: "YouTube",
  facebook: "Facebook",
  web: "Web",
};

function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0])
    .join("")
    .toUpperCase();
}
---

{
  speakers.length > 0 && (
    <section
      id="speakers"
      class="scroll-mt-16 bg-black px-6 py-16 text-white md:py-24"
    >
      <div class="mx-auto max-w-[632px] text-center">
        <h2 class="text-4xl leading-[1.2] font-bold md:text-[56px]">
          Speakers
        </h2>
        <div
          class="from-tj-cyan to-tj-purple mt-4 h-1 rounded-full bg-linear-to-r"
          aria-hidden="true"
        />
      </div>

      <ul class="mx-auto mt-12 flex max-w-6xl flex-wrap justify-center gap-6">
        {speakers.map(({ participant, person }) => {
          const bio = participant.bioOverride ?? person.bio;
          // Firestore doesn't keep the order of map keys, so list the links in the
          // order of SOCIAL_LABELS (LinkedIn first) and unknown ones last.
          const rank = (type: string) => {
            const i = Object.keys(SOCIAL_LABELS).indexOf(type);
            return i === -1 ? Infinity : i;
          };
          const socials = Object.entries(person.socials)
            .filter(([, url]) => url)
            .sort(([a], [b]) => rank(a) - rank(b));
          return (
            <li class="tj-card-rise flex w-full flex-col p-4 sm:w-[calc(50%-0.75rem)] lg:w-[calc((100%-3rem)/3)]">
              {person.photoUrl ? (
                <Image
                  src={person.photoUrl}
                  alt={person.name}
                  width={480}
                  height={360}
                  densities={[1, 2]}
                  class="aspect-[4/3] w-full rounded-3xl object-cover"
                />
              ) : (
                <div
                  class="from-tj-cyan via-tj-blue to-tj-purple flex aspect-[4/3] w-full items-center justify-center rounded-3xl bg-linear-to-br text-5xl font-bold text-black/70"
                  aria-hidden="true"
                >
                  {initials(person.name)}
                </div>
              )}
              <div class="flex flex-1 flex-col px-2 pt-5 pb-2">
                <h3 class="font-display text-2xl leading-tight font-medium">
                  {person.name}
                </h3>
                {participant.talkTitle && (
                  <p class="tj-text-gradient font-display mt-2 text-lg leading-snug font-medium">
                    {participant.talkTitle}
                  </p>
                )}
                {bio && (
                  <p class="text-tj-muted mt-3 line-clamp-4 text-sm leading-relaxed">
                    {bio}
                  </p>
                )}
                {socials.length > 0 && (
                  <ul class="mt-auto flex flex-wrap gap-2 pt-5 text-xs">
                    {socials.map(([type, url]) => (
                      <li>
                        <a
                          href={url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="hover:border-tj-cyan focus-visible:outline-tj-cyan block rounded-full border border-white/20 px-3 py-1 text-white/85 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2"
                        >
                          {SOCIAL_LABELS[type] ?? type}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  )
}
