---
import type { PublicEvent } from "../lib/event";
interface Props {
  event: PublicEvent | null;
}
const { event } = Astro.props;

// The event's own pages, falling back to GDG Cochabamba's.
const socials = [
  {
    name: "Facebook",
    href: event?.socialUrls.facebook ?? "https://www.facebook.com/GDGCochabamba",
    icon: "/techjoin/icon-facebook.svg",
  },
  {
    name: "Instagram",
    href: event?.socialUrls.instagram ?? "https://instagram.com/gdgcochabamba",
    icon: "/techjoin/icon-instagram.svg",
  },
];
const year = event?.edition ?? new Date().getFullYear();
---

<footer class="tj-bg px-6 py-16 text-white">
  <ul class="flex items-center justify-center gap-12">
    {
      socials.map((social) => (
        <li>
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.name}
            class="focus-visible:outline-tj-cyan block rounded-full transition-transform hover:scale-110 focus-visible:outline-2 focus-visible:outline-offset-4 motion-reduce:transition-none"
          >
            <img src={social.icon} alt="" width="40" height="40" />
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mx-auto mt-12 max-w-[1170px] text-center text-[13px]">
    © {year} TechJoin. Todos los derechos reservados. Hecho con ❤️ para
    profesionales que cambian de carrera.
  </p>
</footer>
