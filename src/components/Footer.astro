---
import type { PublicEvent } from "../lib/event";
interface Props {
  event: PublicEvent | null;
}
const { event } = Astro.props;
const socials = event?.socialUrls ?? {};
const hasSocials = Object.values(socials).some(Boolean);
const year = event?.endDate ? event.endDate.getFullYear() : event?.edition;
---

<footer class="bg-slate-900 py-12 text-slate-300">
  <div class="mx-auto max-w-6xl px-6 text-center">
    <h3 class="mb-2 text-xl font-semibold text-white">
      {event?.name ?? "TechJoin Cochabamba"}
    </h3>
    {event?.tagline && <p class="mb-6 text-sm text-slate-400">{event.tagline}</p>}

    {hasSocials && (
      <div class="mb-6 flex flex-wrap justify-center gap-4 text-sm">
        {Object.entries(socials).map(([type, url]) =>
          url ? (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-300 transition hover:text-white"
            >
              {type}
            </a>
          ) : null,
        )}
      </div>
    )}

    <p class="text-xs text-slate-500">
      © {year ?? new Date().getFullYear()} GDG Cochabamba
    </p>
  </div>
</footer>
