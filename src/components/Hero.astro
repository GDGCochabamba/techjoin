---
import type { PublicEvent } from "../lib/event";
interface Props {
  event: PublicEvent | null;
  date?: string;
}
const { event, date } = Astro.props;
const primary = event?.theme?.primaryColor ?? "#2475e5";
const secondary = event?.theme?.secondaryColor ?? "#34a853";
---

<section
  class="relative overflow-hidden text-white"
  style={`background-image: linear-gradient(135deg, ${primary} 0%, ${secondary} 100%);`}
>
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-6 py-24 text-center">
    {event?.logoUrl && (
      <img src={event.logoUrl} alt={event.name} class="mb-2 h-20 w-auto" />
    )}
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
      {event?.name ?? "TechJoin"} {event?.edition ?? ""}
    </h1>
    {event?.tagline && (
      <p class="max-w-3xl text-lg text-white/90 sm:text-xl">{event.tagline}</p>
    )}
    {date && (
      <div class="mt-2 rounded-full bg-white/15 px-5 py-2 text-sm font-medium backdrop-blur">
        {date}
      </div>
    )}
    {event?.registrationUrl && (
      <a
        href={event.registrationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 font-semibold text-slate-900 shadow transition hover:bg-slate-100"
      >
        Registrarme
      </a>
    )}
  </div>
  {event?.coverImageUrl && (
    <div class="relative mx-auto -mt-8 max-w-5xl px-6 pb-12">
      <img
        src={event.coverImageUrl}
        alt={`${event.name} cover`}
        class="mx-auto w-full max-w-3xl rounded-2xl shadow-2xl"
      />
    </div>
  )}
</section>
