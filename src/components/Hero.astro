---
interface Props {
  description: string;
  cta?: { label: string; href: string };
}
const { description, cta } = Astro.props;
---

<section
  id="inicio"
  class="tj-bg relative scroll-mt-16 overflow-hidden text-white"
>
  <div
    class="relative mx-auto max-w-[1440px] px-6 pt-20 pb-24 md:px-16 md:pt-32 md:pb-32 xl:min-h-[667px]"
  >
    <div class="relative z-10 xl:max-w-[min(778px,52vw)]">
      <h1
        class="tj-text-gradient font-display max-w-[640px] pb-1 text-5xl leading-none font-medium md:text-[64px]"
      >
        Conecta, aprende y transforma tu carrera.
      </h1>
      <p class="text-tj-muted mt-6 max-w-[778px] text-lg leading-snug md:text-2xl">
        {description}
      </p>
      <div class="mt-12 flex flex-wrap gap-4 sm:gap-6">
        {
          cta && (
            <a
              href={cta.href}
              target="_blank"
              rel="noopener noreferrer"
              class="tj-btn focus-visible:outline-tj-cyan h-[61px] w-full px-8 text-xl whitespace-nowrap focus-visible:outline-2 focus-visible:outline-offset-4 sm:w-auto sm:min-w-64 md:text-2xl"
            >
              {cta.label}
            </a>
          )
        }
        <a
          href="#sobre-el-evento"
          class="tj-btn-outline focus-visible:outline-tj-cyan h-[61px] w-full px-8 text-xl whitespace-nowrap focus-visible:outline-2 focus-visible:outline-offset-4 sm:w-auto sm:min-w-64 md:text-2xl"
        >
          Saber más
        </a>
      </div>
    </div>
    <img
      src="/techjoin/hero-art.svg"
      alt=""
      aria-hidden="true"
      width="654"
      height="621"
      class="pointer-events-none absolute top-[249px] right-[-122px] hidden w-[min(654px,45vw)] xl:block"
    />
  </div>
</section>
