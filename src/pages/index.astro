---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Speakers from "../components/Speakers.astro";
import Sponsors from "../components/Sponsors.astro";
import Footer from "../components/Footer.astro";
import {
  formatEventDate,
  getEventBySlug,
  getEventSpeakers,
  getEventSponsors,
} from "../lib/event";

const slug = import.meta.env.PUBLIC_EVENT_SLUG ?? "techjoin-2025";
const event = await getEventBySlug(slug);

let speakers: Awaited<ReturnType<typeof getEventSpeakers>> = [];
let sponsors: Awaited<ReturnType<typeof getEventSponsors>> = [];
if (event) {
  [speakers, sponsors] = await Promise.all([
    getEventSpeakers(event.id),
    getEventSponsors(event.id),
  ]);
}

const title = event ? `${event.name} ${event.edition}` : "TechJoin Cochabamba";
const formattedDate = event ? formatEventDate(event) : undefined;
---

<Layout title={title}>
  <Hero event={event} date={formattedDate} />
  <About event={event} date={formattedDate} />
  <Speakers speakers={speakers} />
  <Sponsors sponsors={sponsors} />
  <Footer event={event} />
</Layout>
